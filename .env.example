# Copy to `.env.local` and fill in values. Do not commit `.env.local`.

# Chat (required for /api/chat)
ANTHROPIC_API_KEY=

# Demo rate limits (required in production / Netlify)
# Free tier: https://upstash.com — create a Redis database and paste REST credentials
# Caps: 25 messages / visitor / day + 200 messages / day globally
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: LangSmith tracing
LANGSMITH_TRACING=true
# Public base URL for your LangSmith region (US or EU) — not a secret credential
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=TennisCoach

# Legacy names (SDK also reads these)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=

# RAG / PDF ingest (optional for local dev)
CHROMADB_API_KEY=
CHROMADB_TENANT=
CHROMADB_DATABASE=
CHROMADB_CLOUD=

OPENROUTER_API_KEY=

PDF_CHUNK_SIZE=2500
PDF_CHUNK_OVERLAP=250
